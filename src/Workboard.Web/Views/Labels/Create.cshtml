@model CreateLabelViewModel
@{ ViewData["Title"] = "Create label"; }
<h1>Create label in @Model.Project.Key</h1>
<div class="row"><div class="col-md-6">
<form asp-action="Create" asp-route-projectId="@Model.ProjectId" method="post">
    <input asp-for="ProjectId" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group">
        <label asp-for="Name"></label><input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Create label</button>
    <a asp-action="Index" asp-route-projectId="@Model.ProjectId" class="btn btn-default">Cancel</a>
</form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
