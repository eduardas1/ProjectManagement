@model ArchiveDocumentViewModel
<p class="project-text">@Model.Details.Document.Title</p>
<form data-modal-submit asp-action="Archive" asp-route-projectId="@Model.ProjectId" asp-route-id="@Model.DocumentId" method="post">
    <input asp-for="ProjectId" type="hidden" /><input asp-for="DocumentId" type="hidden" /><input asp-for="ExpectedVersion" type="hidden" /><input asp-for="IsArchived" type="hidden" />
    <div asp-validation-summary="All" class="text-danger" tabindex="-1" role="alert"></div>
    <div class="form-actions">
        <button type="submit" class="btn btn-warning">@(Model.IsArchived == true ? "Archive document" : "Restore document")</button>
        <a asp-action="Details" asp-route-projectId="@Model.ProjectId" asp-route-id="@Model.DocumentId" class="btn btn-default" data-modal-cancel>Cancel</a>
        <a asp-action="Archive" asp-route-projectId="@Model.ProjectId" asp-route-id="@Model.DocumentId" data-modal-reload>Reload current version</a>
    </div>
</form>
