@model ProjectManagement.Application.Projects.ProjectDetails
@{
    ViewData["Title"] = "Overview";
    ViewData["WorkProject"] = new ProjectManagement.Application.WorkItems.WorkProject(Model.Id, Model.Key, Model.Name, Model.IsArchived, Model.IsOwner);
}

<section data-modal-region>
<div data-modal-notice class="alert hidden" role="status"></div>
<div data-modal-read-url="@Url.Action("Details", new { id = Model.Id })" data-modal-read-view="project">
<partial name="_Details" model="Model" />
</div></section>
