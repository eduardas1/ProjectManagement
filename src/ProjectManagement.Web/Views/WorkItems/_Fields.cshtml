@using Microsoft.AspNetCore.Mvc.Rendering
@using ProjectManagement.Domain.Enums
@model WorkItemForm
<div class="form-group">
    <label asp-for="Title"></label><input asp-for="Title" class="form-control" />
    <span asp-validation-for="Title" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="Description"></label><textarea asp-for="Description" class="form-control" rows="8"></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="Priority"></label><select asp-for="Priority" asp-items="Html.GetEnumSelectList<WorkItemPriority>()" class="form-control"></select>
    <span asp-validation-for="Priority" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="AssigneeId">Assignee</label><select asp-for="AssigneeId" asp-items="@(new SelectList(Model.Options.Members, "Id", "Email"))" class="form-control"><option value="">Unassigned</option>
        @if (!string.IsNullOrEmpty(Model.AssigneeId) && !Model.Options.Members.Any(member => member.Id == Model.AssigneeId))
        { <option value="@Model.AssigneeId">Unavailable account</option> }
    </select>
    <span asp-validation-for="AssigneeId" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="DueDate">Due date</label><input asp-for="DueDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
    <span asp-validation-for="DueDate" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="LabelIds">Labels</label>
    @if (Model.Options.Labels.Count == 0 && (Model.LabelIds == null || Model.LabelIds.Length == 0)) { <p class="form-control-static">No project labels.</p> }
    else
    {
        <select asp-for="LabelIds" asp-items="@(new SelectList(Model.Options.Labels, "Id", "Name"))" class="form-control" size="5">
            @foreach (var id in (Model.LabelIds ?? []).Where(id => !Model.Options.Labels.Any(label => label.Id == id)))
            { <option value="@id">Unavailable label</option> }
        </select>
        <p class="help-block">Choose any project labels. Leave empty for no labels.</p>
    }
    <span asp-validation-for="LabelIds" class="text-danger"></span>
</div>
