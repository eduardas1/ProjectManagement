@model ProjectManagement.Application.Documents.DocumentRevisions
<p class="project-text">@Model.Document.Title</p>
<p><a asp-action="Details" asp-route-projectId="@Model.Project.Id" asp-route-id="@Model.Document.Id">Back to document</a></p>
<div class="table-responsive"><table table-options="@(Model.Table ?? new())" table-page="@Model.Page" table-total="@Model.Total" table-context="true" class="table table-striped">
    <thead><tr><th table-sort="version">Version</th><th table-sort="title">Title</th><th table-sort="saved">Saved (UTC)</th><th table-sort="editor">Editor</th></tr></thead>
    <tbody>@foreach (var revision in Model.Items)
    { <tr><td><a data-context-link asp-action="Revision" asp-route-projectId="@Model.Project.Id" asp-route-documentId="@Model.Document.Id" asp-route-id="@revision.Id">Version @revision.Version</a></td><td class="project-text">@revision.Title</td><td>@revision.SavedAtUtc.ToString("yyyy-MM-dd HH:mm")</td><td class="project-text"><partial name="_Person" model="revision.Editor" /></td></tr> }
    </tbody>
</table></div>
