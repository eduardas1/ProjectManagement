@model WorkItemArchiveViewModel
<p class="project-text">@Model.Details.Project.Key-@Model.Details.Item.Number @Model.Details.Item.Title</p>
<form data-modal-submit asp-action="Archive" asp-route-projectId="@Model.ProjectId" asp-route-id="@Model.WorkItemId" method="post">
    <input asp-for="ProjectId" type="hidden" /><input asp-for="WorkItemId" type="hidden" /><input asp-for="ExpectedVersion" type="hidden" /><input asp-for="IsArchived" type="hidden" />
    <div asp-validation-summary="All" class="text-danger" tabindex="-1" role="alert"></div>
    <div class="form-actions">
        <button type="submit" class="btn @(Model.IsArchived ? "btn-warning" : "btn-primary")">@(Model.IsArchived ? "Archive work item" : "Restore work item")</button>
        <a asp-action="Details" asp-route-projectId="@Model.ProjectId" asp-route-id="@Model.WorkItemId" class="btn btn-default" data-modal-cancel>Cancel</a>
        <a asp-action="Archive" asp-route-projectId="@Model.ProjectId" asp-route-id="@Model.WorkItemId" data-modal-reload>Reload current version</a>
    </div>
</form>
