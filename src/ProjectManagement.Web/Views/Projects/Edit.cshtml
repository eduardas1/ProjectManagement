@model EditProjectViewModel
@{
    ViewData["Title"] = "Edit project";
}

<h1>Edit @Model.Key</h1>
<div class="row"><div class="col-md-8">
<form asp-action="Edit" asp-route-id="@Model.ProjectId" method="post">
    <input asp-for="ProjectId" type="hidden" />
    <input asp-for="ExpectedVersion" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" class="form-control" rows="6"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save changes</button>
    <a asp-action="Details" asp-route-id="@Model.ProjectId" class="btn btn-default">Cancel</a>
    <a asp-action="Edit" asp-route-id="@Model.ProjectId">Reload current version</a>
</form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
