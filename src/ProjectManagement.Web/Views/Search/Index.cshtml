@using ProjectManagement.Domain.Enums
@model WorkSearchViewModel
@{ ViewData["Title"] = "Search"; ViewData["WorkProject"] = Model.Options.Project; }
<h1>Search</h1>

<form data-workspace-get data-search-form data-editor-source="@Url.Content("~/lib/codemirror/codemirror.min.js")" asp-controller="Search" asp-action="Index" method="get">
    <input name="projectId" value="@Model.Options.Project.Id" type="hidden" />
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <div class="row">
        <div class="col-sm-6 form-group"><label asp-for="Input.Text">Text or work key</label><input asp-for="Input.Text" maxlength="200" class="form-control" /></div>
        <div class="col-sm-2 form-group"><label asp-for="Input.Type">Type</label><select asp-for="Input.Type" asp-items="Html.GetEnumSelectList<WorkItemType>()" class="form-control"><option value="">Any type</option></select></div>
        <div class="col-sm-2 form-group"><label asp-for="Input.Status">Status</label><select asp-for="Input.Status" asp-items="Html.GetEnumSelectList<WorkItemStatus>()" class="form-control"><option value="">Any status</option></select></div>
        <div class="col-sm-2 form-group"><label asp-for="Input.Priority">Priority</label><select asp-for="Input.Priority" asp-items="Html.GetEnumSelectList<WorkItemPriority>()" class="form-control"><option value="">Any priority</option></select></div>
    </div>
    <div class="row">
        <div class="col-sm-4 form-group"><label asp-for="Input.AssigneeId">Assignee</label><select asp-for="Input.AssigneeId" class="form-control"><option value="">Any assignee</option>@foreach (var member in Model.Options.Members) { <option value="@member.Id">@member.ChoiceLabel</option> }</select>
            <div class="checkbox"><label><input asp-for="Input.UnassignedOnly" /> Unassigned only</label></div>
        </div>
        <div class="col-sm-4 form-group"><label asp-for="Input.Label">Label</label><select asp-for="Input.Label" class="form-control"><option value="">Any label</option>@foreach (var label in Model.Options.Labels) { <option value="@label">@label</option> }</select></div>
        <div class="col-sm-2 form-group"><label asp-for="Input.DeadlineFrom">Due from</label><input asp-for="Input.DeadlineFrom" asp-format="{0:yyyy-MM-dd}" type="date" class="form-control" /></div>
        <div class="col-sm-2 form-group"><label asp-for="Input.DeadlineThrough">Due through</label><input asp-for="Input.DeadlineThrough" asp-format="{0:yyyy-MM-dd}" type="date" class="form-control" /></div>
    </div>
    <span data-expression-indicator class="text-muted">@(string.IsNullOrWhiteSpace(Model.Input.Expression) ? "" : "Expression active")</span>
    <details class="advanced-search" data-advanced-search open="@(!string.IsNullOrWhiteSpace(Model.Input.Expression) || ViewData.ModelState.ContainsKey("Input.Expression") && ViewData.ModelState["Input.Expression"]!.Errors.Count > 0)">
        <summary>Advanced search</summary>
    <div class="form-group"><label id="expression-label" asp-for="Input.Expression">Advanced expression</label><textarea asp-for="Input.Expression" maxlength="2000" rows="2" class="form-control"></textarea>
    </div>
        <button type="button" class="btn btn-default btn-sm hidden" data-expression-clear>Clear advanced expression</button>
    </details>
    <script type="application/json" data-search-grammar>@Json.Serialize(new {
        fields = ProjectManagement.Application.Search.WorkSearchGrammar.Fields,
        members = Model.Options.Members.Select(member => new { id = member.Id, label = member.ChoiceLabel }),
        labels = Model.Options.Labels
    })</script>
    <input asp-for="Input.Ordering" type="hidden" />
    <input asp-for="Input.PageSize" type="hidden" />
    <button type="submit" class="btn btn-primary">Search</button>
    <a data-workspace-link asp-action="Index" asp-route-projectId="@Model.Options.Project.Id" class="btn btn-default">Clear</a>
</form>
<details>
    <summary>Advanced search help</summary>
    <p><code>(status=Todo|status=InProgress),priority=High</code></p>
    <dl class="search-syntax">@foreach (var field in ProjectManagement.Application.Search.WorkSearchGrammar.Fields)
    { <dt><code>@field.Name</code></dt><dd><code>@string.Join(" ", field.Operators)</code></dd> }</dl>
    <p><code>, | ( ) \ /i</code></p>
</details>
@if (Model.Results is { } results)
{
    <h2>Results</h2>

        <p class="action-links"><a data-workspace-link asp-controller="Reports" asp-action="Index" asp-route-projectId="@results.Project.Id" asp-route-Input.Expression="@results.Expression" asp-route-Input.Ordering="@results.Ordering" asp-route-Input.Page="@results.Page" asp-route-Input.PageSize="@results.PageSize" class="btn btn-default">Progress for these results</a></p>

    <p>Expression: <code class="search-expression">@(results.Expression.Length == 0 ? "All work" : results.Expression)</code></p>

    @if (results.Total == 0) { <p>No matching work items.</p> }
    else
    {
        <div class="table-responsive"><table table-options="@(new ProjectManagement.Application.Common.TableOptions(results.Ordering.Split(' ')[0].Split(',')[0], results.Ordering.Split(',')[0].EndsWith(" desc"), results.PageSize))" table-search="true" table-page="@results.Page" table-total="@results.Total" class="table table-striped search-results">
            <thead><tr><th table-sort="number">Key</th><th table-sort="title">Title</th><th table-sort="type">Type</th><th table-sort="status">Status</th><th table-sort="priority">Priority</th><th table-sort="assignee">Assignee</th><th table-sort="deadline">Due date</th> <th>Actions</th> </tr></thead>
            <tbody>@foreach (var work in results.Items)
            {
                <tr data-work-id="@work.Id"><td><a data-work-preview asp-controller="WorkItems" asp-action="Details" asp-route-projectId="@results.Project.Id" asp-route-id="@work.Id">@results.Project.Key-@work.Number</a></td>
                    <td class="project-text"><a data-work-preview asp-controller="WorkItems" asp-action="Details" asp-route-projectId="@results.Project.Id" asp-route-id="@work.Id">@work.Title</a></td><td><partial name="_WorkType" model="work.Type" /></td><td>@work.Status</td><td>@work.Priority</td><td><partial name="_Person" model="work.Assignee" /></td><td>@(work.DueDate?.ToString("yyyy-MM-dd") ?? "None")</td>
                     <td><a asp-controller="WorkItems" data-modal-form data-modal-title="Change status" asp-action="Status" asp-route-projectId="@results.Project.Id" asp-route-id="@work.Id" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)">Change status<span class="sr-only"> for @results.Project.Key-@work.Number</span></a></td>
                </tr>
            }</tbody>
        </table></div>
    }

}
