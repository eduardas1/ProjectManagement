<aside class="work-preview hidden" id="work-preview" role="dialog" aria-labelledby="work-preview-title" aria-modal="false" tabindex="-1" data-work-panel data-modal-region>
    <div class="preview-resize" role="separator" tabindex="0" aria-label="Resize work item panel" aria-orientation="vertical" aria-controls="work-preview" data-preview-resize></div>
    <header class="preview-toolbar"><h2 id="work-preview-title" class="h4">Work item</h2><div><a class="btn btn-default" data-preview-full>Open full page</a> <button type="button" class="btn btn-default" data-preview-close aria-label="Close work item"><span aria-hidden="true">&times;</span></button></div></header>
    <div class="alert alert-danger hidden" role="alert" data-preview-error></div>
    <div class="alert hidden" role="status" data-modal-notice></div>
    <div class="preview-body" data-preview-body></div>
</aside>
