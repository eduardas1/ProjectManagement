@using ProjectManagement.Domain.Enums
@model ProjectManagement.Application.WorkItems.WorkItemList
@{
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    ViewData["Title"] = action == "Backlog" ? "Backlog" : action == "Cancelled" ? "Cancelled work" : "All work";
    ViewData["WorkProject"] = Model.Project;
}
<h1>@ViewData["Title"]</h1>

<form data-workspace-get asp-action="Index" method="get" class="form-inline">
    <input name="projectId" value="@Model.Project.Id" type="hidden" />
    <div class="form-group"><label for="status">Status</label>
        <select name="status" id="status" class="form-control"><option value="">All statuses</option>
        @foreach (var status in Enum.GetValues<WorkItemStatus>()) { <option value="@status" selected="@(Model.Status == status)">@status</option> }
        </select>
    </div>
    <button type="submit" class="btn btn-default">Filter</button>
</form>
@if (Model.Total == 0) { <p>No work items.</p> }
else
{
    <div class="table-responsive"><table table-options="@(Model.Table ?? new())" table-page="@Model.Page" table-total="@Model.Total" class="table table-striped">
        <thead><tr><th table-sort="number">Key</th><th table-sort="title">Title</th><th table-sort="type">Type</th><th table-sort="status">Status</th><th table-sort="priority">Priority</th><th table-sort="assignee">Assignee</th><th table-sort="deadline">Due date</th> <th>Actions</th> </tr></thead>
        <tbody>
        @foreach (var work in Model.Items)
        {
            <tr data-work-id="@work.Id"><td><a data-work-preview asp-action="Details" asp-route-projectId="@Model.Project.Id" asp-route-id="@work.Id">@Model.Project.Key-@work.Number</a></td>
                <td class="project-text"><a data-work-preview asp-action="Details" asp-route-projectId="@Model.Project.Id" asp-route-id="@work.Id">@work.Title</a></td><td><partial name="_WorkType" model="work.Type" /></td><td>@work.Status</td><td>@work.Priority</td><td><partial name="_Person" model="work.Assignee" /></td><td>@(work.DueDate?.ToString("yyyy-MM-dd") ?? "None")</td>
                 <td><a data-modal-form data-modal-title="Change status" asp-action="Status" asp-route-projectId="@Model.Project.Id" asp-route-id="@work.Id" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)">Change status<span class="sr-only"> for @Model.Project.Key-@work.Number</span></a></td>
            </tr>
        }
        </tbody>
    </table></div>
}
