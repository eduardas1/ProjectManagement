@model ProjectManagement.Application.WorkItems.WorkBoard
@{ ViewData["Title"] = "Board"; ViewData["WorkProject"] = Model.Project; }
<header class="workspace-heading"><div><h1>Board</h1></div>
 <a data-modal-form data-modal-title="Create work item" data-modal-size="large" asp-action="Create" asp-route-projectId="@Model.Project.Id" class="btn btn-primary">Create work item</a>
</header>

<div class="alert hidden" role="status" data-modal-notice data-board-notice></div>
<div id="work-board" data-modal-list-url="@Url.Action("Board", new { projectId = Model.Project.Id })">
    <partial name="_Board" model="Model" />
</div>
