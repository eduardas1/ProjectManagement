@model DocumentPreviewViewModel
@if (!Enum.IsDefined(Model.Format))
{ <p class="alert alert-warning">Unsupported format. Showing plain text.</p> }
@if (string.IsNullOrEmpty(Model.Body)) { <p class="text-muted">No document text.</p> }
else
{
    <div class="document-body @(Model.Format == ProjectManagement.Domain.Enums.DocumentFormat.Markdown ? "document-markdown" : "document-plain")" data-document-text>@Html.Raw(ProjectManagement.Web.Services.DocumentRenderer.Render(Model.Body, Model.Format))</div>
}
