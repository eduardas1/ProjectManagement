@using ProjectManagement.Domain.Enums
@model WorkSearchViewModel
@{ ViewData["Title"] = Model.Options.Project.Key + " search"; ViewData["WorkProject"] = Model.Options.Project; }
<h1 class="project-text">@Model.Options.Project.Key search</h1>
@if (Model.Options.Project.IsArchived) { <div class="alert alert-info">This project is archived. Its work remains searchable.</div> }
<form data-workspace-get data-search-form data-editor-source="@Url.Content("~/lib/codemirror/codemirror.min.js")" asp-controller="Search" asp-action="Index" method="get">
    <input name="projectId" value="@Model.Options.Project.Id" type="hidden" />
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <div class="row">
        <div class="col-sm-6 form-group"><label asp-for="Input.Text">Text or work key</label><input asp-for="Input.Text" maxlength="200" class="form-control" /></div>
        <div class="col-sm-2 form-group"><label asp-for="Input.Type">Type</label><select asp-for="Input.Type" asp-items="Html.GetEnumSelectList<WorkItemType>()" class="form-control"><option value="">Any type</option></select></div>
        <div class="col-sm-2 form-group"><label asp-for="Input.Status">Status</label><select asp-for="Input.Status" asp-items="Html.GetEnumSelectList<WorkItemStatus>()" class="form-control"><option value="">Any status</option></select></div>
        <div class="col-sm-2 form-group"><label asp-for="Input.Priority">Priority</label><select asp-for="Input.Priority" asp-items="Html.GetEnumSelectList<WorkItemPriority>()" class="form-control"><option value="">Any priority</option></select></div>
    </div>
    <div class="row">
        <div class="col-sm-4 form-group"><label asp-for="Input.AssigneeId">Assignee</label><select asp-for="Input.AssigneeId" class="form-control"><option value="">Any assignee</option>@foreach (var member in Model.Options.Members) { <option value="@member.Id">@member.ChoiceLabel</option> }</select>
            <div class="checkbox"><label><input asp-for="Input.UnassignedOnly" /> Unassigned only</label></div>
        </div>
        <div class="col-sm-4 form-group"><label asp-for="Input.Label">Label</label><select asp-for="Input.Label" class="form-control"><option value="">Any label</option>@foreach (var label in Model.Options.Labels) { <option value="@label">@label</option> }</select></div>
        <div class="col-sm-2 form-group"><label asp-for="Input.DeadlineFrom">Due from</label><input asp-for="Input.DeadlineFrom" asp-format="{0:yyyy-MM-dd}" type="date" class="form-control" /></div>
        <div class="col-sm-2 form-group"><label asp-for="Input.DeadlineThrough">Due through</label><input asp-for="Input.DeadlineThrough" asp-format="{0:yyyy-MM-dd}" type="date" class="form-control" /></div>
    </div>
    <div class="search-mode-actions">
        <button type="button" class="btn btn-default hidden" data-search-basic>Basic search</button>
        <button type="button" class="btn btn-default hidden" data-search-advanced>Advanced search</button>
        <span data-expression-indicator class="text-muted">@(string.IsNullOrWhiteSpace(Model.Input.Expression) ? "" : "An advanced expression is active.")</span>
    </div>
    <details class="advanced-search" data-advanced-search open="@(!string.IsNullOrWhiteSpace(Model.Input.Expression) || ViewData.ModelState.ContainsKey("Input.Expression") && ViewData.ModelState["Input.Expression"]!.Errors.Count > 0)">
        <summary>Advanced search</summary>
    <div class="form-group"><label id="expression-label" asp-for="Input.Expression">Advanced expression</label><textarea asp-for="Input.Expression" maxlength="2000" rows="2" class="form-control" aria-describedby="expression-help"></textarea>
        <p id="expression-help" class="help-block">Basic controls and this expression combine with AND. At most 2000 combined characters, 32 comparisons and 8 nested groups.</p>
    </div>
        <button type="button" class="btn btn-default btn-sm hidden" data-expression-clear>Clear advanced expression</button>
        <p class="help-block">Use arrow keys to choose a suggestion, Enter or Tab to accept, and Escape to close. Ctrl+Space opens suggestions.</p>
    </details>
    <script type="application/json" data-search-grammar>@Json.Serialize(new {
        fields = ProjectManagement.Application.Search.WorkSearchGrammar.Fields,
        members = Model.Options.Members.Select(member => new { id = member.Id, label = member.ChoiceLabel }),
        labels = Model.Options.Labels
    })</script>
    <div class="row">
        <div class="col-sm-6 form-group"><label asp-for="Input.Ordering">Order by</label><input asp-for="Input.Ordering" maxlength="200" placeholder="number" class="form-control" aria-describedby="ordering-help" /><p id="ordering-help" class="help-block">number, title or deadline, optionally asc or desc. Example: deadline desc,number.</p></div>
        <div class="col-sm-2 form-group"><label asp-for="Input.PageSize">Page size</label><input asp-for="Input.PageSize" type="number" min="1" max="100" class="form-control" /></div>
        <div class="col-sm-4 form-group"><div class="checkbox"><label><input asp-for="Input.Archived" /> Search archived work instead of active work</label></div></div>
    </div>
    <button type="submit" class="btn btn-primary">Search</button>
    <a data-workspace-link asp-action="Index" asp-route-projectId="@Model.Options.Project.Id" class="btn btn-default">Clear</a>
</form>
<details>
    <summary>Advanced search help</summary>
    <p>Fields: <code>type</code>, <code>status</code>, <code>priority</code>, <code>assignee</code> (account ID), <code>label</code>, <code>deadline</code>, <code>title</code>, <code>description</code>, <code>number</code>.</p>
    <p>Use <code>,</code> for AND, <code>|</code> for OR and parentheses for grouping. Without groups, operators apply left to right. This is not Jira JQL.</p>
    <p>Example: <code>(status=Todo|status=InProgress),priority=High</code>. Enum values use the names shown above. Text operators: <code>=</code>, <code>!=</code>, <code>=*</code>, <code>!*</code>, <code>^</code>, <code>!^</code>, <code>$</code>, <code>!$</code>. Labels support only positive <code>=</code>, <code>=*</code>, <code>^</code> and <code>$</code>.</p>
    <p>Use a backslash for literal syntax characters, for example <code>title=Payment \(retry\)</code>. Text matching is case-sensitive unless you append <code>/i</code>; use that flag only for ASCII text. Other text requires exact case and accents. Basic searches fold ASCII-only input and match other input exactly.</p>
    <p>Numbers and ISO dates support <code>=</code>, <code>!=</code>, <code>&lt;</code>, <code>&lt;=</code>, <code>&gt;</code> and <code>&gt;=</code>. <code>deadline=</code> finds missing due dates and <code>assignee=</code> finds unassigned work. A complete work key in the text box is treated as a key in this project.</p>
</details>
@if (Model.Results is { } results)
{
    <h2>Results</h2>
    @if (!results.Archived)
    {
        <p class="action-links"><a data-workspace-link asp-controller="Reports" asp-action="Index" asp-route-projectId="@results.Project.Id" asp-route-Input.Expression="@results.Expression" asp-route-Input.Ordering="@results.Ordering" asp-route-Input.Page="@results.Page" asp-route-Input.PageSize="@results.PageSize" class="btn btn-default">Progress for these results</a></p>
    }
    <p>Expression: <code class="search-expression">@(results.Expression.Length == 0 ? "All work" : results.Expression)</code></p>
    <p>Order: <code>@results.Ordering</code>. @(results.Archived ? "Archived work" : "Active work").</p>
    @if (results.Total == 0) { <p>No matching work items.</p> }
    else
    {
        <div class="table-responsive"><table class="table table-striped search-results">
            <thead><tr><th>Key</th><th>Title</th><th>Type</th><th>Status</th><th>Priority</th><th>Assignee</th><th>Due date</th>@if (!results.Archived && !results.Project.IsArchived) { <th>Actions</th> }</tr></thead>
            <tbody>@foreach (var work in results.Items)
            {
                <tr data-work-id="@work.Id"><td><a data-work-preview asp-controller="WorkItems" asp-action="Details" asp-route-projectId="@results.Project.Id" asp-route-id="@work.Id">@results.Project.Key-@work.Number</a></td>
                    <td class="project-text"><a data-work-preview asp-controller="WorkItems" asp-action="Details" asp-route-projectId="@results.Project.Id" asp-route-id="@work.Id">@work.Title</a></td><td><partial name="_WorkType" model="work.Type" /></td><td>@work.Status</td><td>@work.Priority</td><td><partial name="_Person" model="work.Assignee" /></td><td>@(work.DueDate?.ToString("yyyy-MM-dd") ?? "None")</td>
                    @if (!results.Archived && !results.Project.IsArchived) { <td><a asp-controller="WorkItems" data-modal-form data-modal-title="Change status" asp-action="Status" asp-route-projectId="@results.Project.Id" asp-route-id="@work.Id" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)">Change status<span class="sr-only"> for @results.Project.Key-@work.Number</span></a></td> }
                </tr>
            }</tbody>
        </table></div>
    }
    <p>Page @results.Page of @results.PageCount (@results.Total @(results.Total == 1 ? "item" : "items"))</p>
    <nav aria-label="Search result pages"><ul class="pager">
        @if (results.Page > 1) { <li><a data-workspace-link asp-action="Index" asp-all-route-data="Model.Routes(results.Page - 1)">Previous</a></li> }
        @if (results.Page < results.PageCount) { <li><a data-workspace-link asp-action="Index" asp-all-route-data="Model.Routes(results.Page + 1)">Next</a></li> }
    </ul></nav>
}

<section data-modal-region>
<div class="alert hidden" role="status" data-modal-notice></div>
@if (Model.Results is { Archived: false } current && !current.Project.IsArchived)
{
    <form asp-controller="SavedSearches" asp-action="Prepare" asp-route-projectId="@current.Project.Id" method="post" data-modal-open data-modal-title="Save search">
        <input name="ProjectId" value="@current.Project.Id" type="hidden" /><input name="Expression" value="@current.Expression" type="hidden" /><input name="Ordering" value="@current.Ordering" type="hidden" /><input name="ReturnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" type="hidden" />
        <button type="submit" class="btn btn-default">Save search</button>
    </form>
}
@if (Model.SavedSearches is { } saved)
{
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    <div id="saved-searches" data-modal-list-url="@Url.Action("Index", "SavedSearches", new { projectId = saved.Project.Id, returnUrl })"><partial name="~/Views/SavedSearches/_List.cshtml" model="new SavedSearchListViewModel(saved, returnUrl)" /></div>
}

</section>
