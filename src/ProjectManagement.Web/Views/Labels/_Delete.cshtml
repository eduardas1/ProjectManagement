@model DeleteLabelViewModel
<form asp-action="Delete" asp-route-projectId="@Model.ProjectId" asp-route-id="@Model.LabelId" method="post" data-modal-submit>
    <p class="project-text">Delete label <strong>@Model.Name</strong>?</p>
    @if (Model.UsageCount > 0)
    { <div class="alert alert-info">Remove this label from its @Model.UsageCount work items before deleting it.</div> }
    <input asp-for="ProjectId" type="hidden" /><input asp-for="LabelId" type="hidden" /><input asp-for="ExpectedVersion" type="hidden" />
    <div asp-validation-summary="All" class="text-danger" role="alert" tabindex="-1"></div>
    @if (Model.UsageCount == 0) { <button type="submit" class="btn btn-danger">Delete label</button> }
    <a asp-action="Index" asp-route-projectId="@Model.ProjectId" class="btn btn-default" data-modal-cancel>Cancel</a>
</form>
