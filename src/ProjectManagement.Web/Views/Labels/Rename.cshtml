@model RenameLabelViewModel
@{ ViewData["Title"] = "Rename label"; }
<h1>Rename label</h1>
<div class="row"><div class="col-md-6"><partial name="_Rename" model="Model" /></div></div>
<p><a asp-action="Rename" asp-route-projectId="@Model.ProjectId" asp-route-id="@Model.LabelId">Reload current version</a></p>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
