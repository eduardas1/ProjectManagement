@using Workboard.Domain.Enums
@model WorkItemLinkViewModel
<p class="project-text">@Model.Details.Project.Key-@Model.Details.Item.Number @(Model.Kind == WorkItemLinkKind.Blocks ? "blocks" : "duplicates") @Model.TargetName</p>
<form data-modal-submit asp-action="RemoveLink" asp-route-projectId="@Model.ProjectId" asp-route-id="@Model.WorkItemId" method="post">
    <input asp-for="ProjectId" type="hidden" /><input asp-for="WorkItemId" type="hidden" /><input asp-for="ExpectedVersion" type="hidden" />
    <input asp-for="TargetId" type="hidden" /><input asp-for="Kind" type="hidden" />
    <div asp-validation-summary="All" class="text-danger" tabindex="-1" role="alert"></div>
    <div class="form-actions">
        <button type="submit" class="btn btn-danger">Remove relationship</button>
        <a asp-action="Details" asp-route-projectId="@Model.ProjectId" asp-route-id="@Model.WorkItemId" class="btn btn-default" data-modal-cancel>Cancel</a>
        <a asp-action="RemoveLink" asp-route-projectId="@Model.ProjectId" asp-route-id="@Model.WorkItemId" asp-route-targetId="@Model.TargetId" asp-route-kind="@Model.Kind" data-modal-reload>Reload current item</a>
    </div>
</form>
