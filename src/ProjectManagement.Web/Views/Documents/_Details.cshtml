@model ProjectManagement.Application.Documents.DocumentDetails
<h1 class="project-text">@Model.Document.Title</h1>
@if (Model.Project.IsArchived || Model.Document.IsArchived)
{ <div class="alert alert-info">This @(Model.Project.IsArchived ? "project" : "document") is archived.</div> }
<p class="action-links"><a asp-action="Index" asp-route-projectId="@Model.Project.Id" asp-route-archived="@Model.Document.IsArchived">Back to documents</a>
<a href="#document-revisions" class="btn btn-default">Revision history</a>
@if (!Model.Project.IsArchived && !Model.Document.IsArchived)
{ <a asp-action="Edit" asp-route-projectId="@Model.Project.Id" asp-route-id="@Model.Document.Id" class="btn btn-default">Edit document</a> }
@if (Model.Project.IsOwner && !Model.Project.IsArchived)
{ <a data-modal-form data-modal-title="Archive or restore document" asp-action="Archive" asp-route-projectId="@Model.Project.Id" asp-route-id="@Model.Document.Id" class="btn btn-default">@(Model.Document.IsArchived ? "Restore document" : "Archive document")</a> }
</p>
<dl class="dl-horizontal">
    <dt>Version</dt><dd>@Model.Document.Version</dd>
    <dt>Created by</dt><dd class="project-text"><partial name="_Person" model="Model.Document.CreatedBy" /></dd>
    <dt>Created (UTC)</dt><dd>@Model.Document.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</dd>
    <dt>Updated by</dt><dd class="project-text"><partial name="_Person" model="Model.Document.UpdatedBy" /></dd>
    <dt>Updated (UTC)</dt><dd>@Model.Document.UpdatedAtUtc.ToString("yyyy-MM-dd HH:mm")</dd>
</dl>
@if (Model.Body.Length == 0) { <p>No document text.</p> }
else { <div class="project-description" data-document-text>@Model.Body</div> }
<h2>Attachments</h2>
<section data-modal-region data-context-region aria-label="Attachments">
<div class="alert hidden" data-modal-notice role="status"></div>
<div data-context-load data-modal-list-url="@Url.Action("Index", "Attachments", new { projectId = Model.Project.Id, documentId = Model.Document.Id })">
<p><a asp-controller="Attachments" asp-action="Index" asp-route-projectId="@Model.Project.Id" asp-route-documentId="@Model.Document.Id">View attachments</a></p>
</div></section>
<h2 id="document-revisions">Revision history</h2>
<section data-modal-region data-context-region aria-label="Revision history">
<div class="alert hidden" data-modal-notice role="status"></div>
<div data-context-load data-modal-list-url="@Url.Action("Revisions", new { projectId = Model.Project.Id, id = Model.Document.Id })">
<p><a asp-action="Revisions" asp-route-projectId="@Model.Project.Id" asp-route-id="@Model.Document.Id">Open revision history</a></p>
</div></section>
<h2>Recent changes</h2>
<div class="table-responsive"><table class="table table-striped">
    <thead><tr><th>Time (UTC)</th><th>Account</th><th>Change</th></tr></thead>
    <tbody>@foreach (var change in Model.History)
    { <tr><td>@change.OccurredAtUtc.ToString("yyyy-MM-dd HH:mm")</td><td class="project-text"><partial name="_Person" model="change.Actor" /></td><td>@change.Summary</td></tr> }
    </tbody>
</table></div>
