@model IReadOnlyList<ProjectManagement.Application.Projects.ProjectSummary>
@{ ViewData["Title"] = "Projects"; }
<h1>Projects</h1>
<p class="action-links"><a asp-action="Create" class="btn btn-primary">Create project</a></p>
@if (Model.Count == 0)
{
    <p>No projects.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead><tr><th>Key</th><th>Name</th><th>Your role</th></tr></thead>
            <tbody>
                @foreach (var project in Model)
                {
                    <tr>
                        <td><a asp-action="Details" asp-route-id="@project.Id">@project.Key</a></td>
                        <td class="project-text">@project.Name</td>
                        <td>@(project.IsOwner ? "Owner" : "Member")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
