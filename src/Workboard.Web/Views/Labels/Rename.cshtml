@model RenameLabelViewModel
@{ ViewData["Title"] = "Rename label"; }
<h1>Rename label</h1>
<div class="row"><div class="col-md-6">
<form asp-action="Rename" asp-route-projectId="@Model.ProjectId" asp-route-id="@Model.LabelId" method="post">
    <input asp-for="ProjectId" type="hidden" /><input asp-for="LabelId" type="hidden" /><input asp-for="ExpectedVersion" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group">
        <label asp-for="Name"></label><input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Rename label</button>
    <a asp-action="Index" asp-route-projectId="@Model.ProjectId" class="btn btn-default">Cancel</a>
    <a asp-action="Rename" asp-route-projectId="@Model.ProjectId" asp-route-id="@Model.LabelId">Reload current version</a>
</form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
