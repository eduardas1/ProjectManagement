@model ProjectManagement.Application.WorkItems.ProjectLabels
<h2 id="labels-title" tabindex="-1" data-modal-focus>Project labels (@Model.Items.Count)</h2>

<p><a asp-controller="WorkItems" asp-action="Index" asp-route-projectId="@Model.Project.Id">Back to work</a>
 <a data-modal-form data-modal-title="Create label" asp-action="Create" asp-route-projectId="@Model.Project.Id" class="btn btn-primary">Create label</a>
</p>
@if (Model.Items.Count == 0) { <p>No project labels.</p> }
else
{
    <div class="table-responsive"><table class="table table-striped">
        <thead><tr><th>Name</th><th>Work items</th><th>Actions</th></tr></thead>
        <tbody>@foreach (var label in Model.Items)
        {
            <tr data-label-id="@label.Id"><td class="project-text">@label.Name</td><td>@label.UsageCount</td><td>

                <a data-modal-form data-modal-title="Rename label" asp-action="Rename" asp-route-projectId="@Model.Project.Id" asp-route-id="@label.Id">Rename</a>
                @if (Model.Project.IsOwner && label.UsageCount == 0)
                { <a data-modal-form data-modal-title="Delete label" asp-action="Delete" asp-route-projectId="@Model.Project.Id" asp-route-id="@label.Id">Delete</a> }

            </td></tr>
        }</tbody>
    </table></div>
}
