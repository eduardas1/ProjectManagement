@model EditCommentViewModel
@{ ViewData["Title"] = "Edit comment"; }
<h1>Edit comment</h1>
<p class="project-text">@Model.Work.Project.Key-@Model.Work.Number @Model.Work.Title</p>
<div class="row"><div class="col-md-8">
<form asp-action="Edit" asp-route-projectId="@Model.ProjectId" asp-route-workItemId="@Model.WorkItemId" asp-route-id="@Model.CommentId" method="post">
    <input asp-for="ProjectId" type="hidden" /><input asp-for="WorkItemId" type="hidden" /><input asp-for="CommentId" type="hidden" /><input asp-for="ExpectedVersion" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group">
        <label asp-for="Body"></label><textarea asp-for="Body" class="form-control" rows="7" maxlength="5000"></textarea>
        <span asp-validation-for="Body" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save comment</button>
    <a asp-action="Index" asp-route-projectId="@Model.ProjectId" asp-route-workItemId="@Model.WorkItemId" class="btn btn-default">Cancel</a>
    <a asp-action="Edit" asp-route-projectId="@Model.ProjectId" asp-route-workItemId="@Model.WorkItemId" asp-route-id="@Model.CommentId">Reload current version</a>
</form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
