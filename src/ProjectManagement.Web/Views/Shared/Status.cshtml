@model int
@{
    ViewData["Title"] = Model switch { 404 => "Page not found", 413 => "Request too large", _ => "Request failed" };
}

<h1>@ViewData["Title"]</h1>
<p>@(Model switch { 404 => "The requested page could not be found.", 413 => "The request exceeds the allowed size.", _ => "The request could not be completed." })</p>
<p><a asp-controller="Home" asp-action="Index">Back to home</a></p>
