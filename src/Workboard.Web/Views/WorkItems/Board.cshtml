@model Workboard.Application.WorkItems.WorkBoard
@{ ViewData["Title"] = Model.Project.Key + " board"; ViewData["WorkProject"] = Model.Project; }
<header class="workspace-heading"><div><p class="text-muted project-text">@Model.Project.Name</p><h1>@Model.Project.Key board</h1></div>
@if (!Model.Project.IsArchived) { <a asp-action="Create" asp-route-projectId="@Model.Project.Id" class="btn btn-primary">Create work item</a> }
</header>
@if (Model.Project.IsArchived) { <div class="alert alert-info">This project is archived.</div> }
<div class="alert hidden" role="status" data-modal-notice data-board-notice></div>
<div id="work-board" data-modal-list-url="@Url.Action("Board", new { projectId = Model.Project.Id })">
    <partial name="_Board" model="Model" />
</div>
<partial name="~/Views/Shared/_ContextModal.cshtml" />
@section Scripts {
    <script src="~/lib/sortable/Sortable.min.js"></script>
    <script src="~/js/context-modal.js" asp-append-version="true"></script>
    <script src="~/js/board.js" asp-append-version="true"></script>
}
