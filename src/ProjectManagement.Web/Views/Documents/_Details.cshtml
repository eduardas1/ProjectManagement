@model ProjectManagement.Application.Documents.DocumentDetails
<div class="document-heading">
    <div><p><a asp-action="Index" asp-route-projectId="@Model.Project.Id">Back to documents</a></p>
    <h1 class="project-text">@Model.Document.Title</h1></div>
     <a asp-action="Edit" asp-route-projectId="@Model.Project.Id" asp-route-id="@Model.Document.Id" class="btn btn-primary">Edit document</a>
</div>

<div class="document-layout">
    <article class="document-reading" aria-label="Document content">
        <partial name="_DocumentBody" model="@(new DocumentPreviewViewModel { Body = Model.Body, Format = Model.Format })" />
    </article>
    <aside class="document-support" aria-label="Document information">
        <details open class="document-metadata"><summary>Document details</summary>
            <dl>
                <dt>Version</dt><dd>@Model.Document.Version</dd>
                <dt>Updated by</dt><dd><partial name="_Person" model="Model.Document.UpdatedBy" /></dd>
                <dt>Updated (UTC)</dt><dd>@Model.Document.UpdatedAtUtc.ToString("yyyy-MM-dd HH:mm")</dd>
                <dt>Created by</dt><dd><partial name="_Person" model="Model.Document.CreatedBy" /></dd>
                <dt>Created (UTC)</dt><dd>@Model.Document.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</dd>
            </dl>
                    </details>
        <details><summary>Attachments</summary>
<section data-modal-region data-context-region aria-label="Attachments">
<div class="alert hidden" data-modal-notice role="status"></div>
<div data-context-load data-modal-list-url="@Url.Action("Index", "Attachments", new { projectId = Model.Project.Id, documentId = Model.Document.Id })">
<p><a asp-controller="Attachments" asp-action="Index" asp-route-projectId="@Model.Project.Id" asp-route-documentId="@Model.Document.Id">View attachments</a></p>
</div></section>
        </details>
        <details id="document-revisions"><summary>Revision history</summary>
<section data-modal-region data-context-region aria-label="Revision history">
<div class="alert hidden" data-modal-notice role="status"></div>
<div data-context-load data-modal-list-url="@Url.Action("Revisions", new { projectId = Model.Project.Id, id = Model.Document.Id })">
<p><a asp-action="Revisions" asp-route-projectId="@Model.Project.Id" asp-route-id="@Model.Document.Id">Open revision history</a></p>
</div></section>
        </details>
        <details><summary>Recent changes</summary>
            <ol class="document-changes">
            @foreach (var change in Model.History)
            { <li><time>@change.OccurredAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</time>
                <div><partial name="_Person" model="change.Actor" /></div><p>@change.Summary</p></li> }
            </ol>
        </details>
    </aside>
</div>
