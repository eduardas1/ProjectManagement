@model AddMemberViewModel
@{ ViewData["Title"] = "Add member"; }

<h1 class="project-text">Add member to @Model.ProjectKey</h1>
<div class="row"><div class="col-md-6">
<form asp-action="Add" asp-route-id="@Model.ProjectId" method="post">
    <input asp-for="ProjectId" type="hidden" />
    <input asp-for="ExpectedVersion" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group">
        <label asp-for="Email"></label>
        <input asp-for="Email" class="form-control" type="email" />
        <span asp-validation-for="Email" class="text-danger"></span>
        <p class="help-block">Enter the exact email address of an existing account.</p>
    </div>
    <button type="submit" class="btn btn-primary">Add member</button>
    <a asp-action="Index" asp-route-id="@Model.ProjectId" class="btn btn-default">Cancel</a>
    <a asp-action="Add" asp-route-id="@Model.ProjectId">Reload current version</a>
</form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
