@using ProjectManagement.Domain.Enums
@model CreateWorkItemViewModel
<form data-modal-submit data-modal-dirty asp-action="Create" asp-route-projectId="@Model.ProjectId" method="post">
    <input asp-for="ProjectId" type="hidden" />
    <input asp-for="DesiredStatus" type="hidden" />
    @if (Model.DesiredStatus != WorkItemStatus.Backlog)
    { <p>Initial status: <strong>@Model.DesiredStatus</strong>.</p> }
    <div asp-validation-summary="ModelOnly" class="text-danger" tabindex="-1" role="alert"></div>
    <div class="form-group">
        <label asp-for="Type"></label><select asp-for="Type" asp-items="Html.GetEnumSelectList<WorkItemType>()" class="form-control"></select>
        <span asp-validation-for="Type" class="text-danger"></span>
    </div>
    <partial name="_Fields" model="Model" />
    <div class="form-group" data-work-parent>
        <label asp-for="ParentId">Parent (Subtask only)</label>
        <select asp-for="ParentId" class="form-control"><option value="">None</option>
        @foreach (var item in Model.Options.Items.Where(item => item.Type is WorkItemType.Bug or WorkItemType.Task or WorkItemType.Story))
        { <option value="@item.Id">@Model.Options.Project.Key-@item.Number @item.Title</option> }
        </select>
        <span asp-validation-for="ParentId" class="text-danger"></span>
    </div>
    <div class="form-group" data-work-epic>
        <label asp-for="EpicId">Epic (Bug, Task or Story only)</label>
        <select asp-for="EpicId" class="form-control"><option value="">None</option>
        @foreach (var item in Model.Options.Items.Where(item => item.Type == WorkItemType.Epic))
        { <option value="@item.Id">@Model.Options.Project.Key-@item.Number @item.Title</option> }
        </select>
        <span asp-validation-for="EpicId" class="text-danger"></span>
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Create work item</button>
        <a asp-action="Index" asp-route-projectId="@Model.ProjectId" class="btn btn-default" data-modal-cancel>Cancel</a>
    </div>
</form>
