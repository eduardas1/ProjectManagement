@using ProjectManagement.Application.WorkItems
@model ProjectManagement.Application.WorkItems.WorkItemDetails
<div class="status-control">
    <span class="label status-badge status-@Model.Item.Status.ToString().ToLowerInvariant()">@Model.Item.Status</span>
    @if (!Model.Project.IsArchived && !Model.Item.IsArchived)
    {
        <form data-inline-status asp-controller="WorkItems" asp-action="Status" asp-route-projectId="@Model.Project.Id" asp-route-id="@Model.Item.Id" method="post">
            <input type="hidden" name="ProjectId" value="@Model.Project.Id" /><input type="hidden" name="WorkItemId" value="@Model.Item.Id" /><input type="hidden" name="ExpectedVersion" value="@Model.Item.Version" />
            <label class="sr-only" for="status-@Model.Item.Id">Change status</label>
            <select id="status-@Model.Item.Id" name="Status" class="form-control" aria-label="Change status for @Model.Project.Key-@Model.Item.Number">
                <option value="@((int)Model.Item.Status)">@Model.Item.Status</option>
                @foreach (var status in WorkItemWorkflow.AllowedStatuses(Model.Item.Status))
                { <option value="@((int)status)">@status</option> }
            </select>
            <button type="submit" class="btn btn-default" data-status-save>Save status</button>
            <span data-status-notice role="status"></span>
        </form>
    }
</div>
