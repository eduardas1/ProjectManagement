@model EditWorkItemViewModel
@{ ViewData["Title"] = "Edit " + Model.WorkKey; }
<h1>Edit @Model.WorkKey</h1>
<div class="row"><div class="col-md-8">
<form asp-action="Edit" asp-route-projectId="@Model.ProjectId" asp-route-id="@Model.WorkItemId" method="post">
    <input asp-for="ProjectId" type="hidden" /><input asp-for="WorkItemId" type="hidden" /><input asp-for="ExpectedVersion" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <partial name="_Fields" model="Model" />
    <button type="submit" class="btn btn-primary">Save work item</button>
    <a asp-action="Details" asp-route-projectId="@Model.ProjectId" asp-route-id="@Model.WorkItemId" class="btn btn-default">Cancel</a>
    <a asp-action="Edit" asp-route-projectId="@Model.ProjectId" asp-route-id="@Model.WorkItemId">Reload current version</a>
</form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
