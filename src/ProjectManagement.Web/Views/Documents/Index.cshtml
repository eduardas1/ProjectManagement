@model ProjectManagement.Application.Documents.ProjectDocuments
@{ ViewData["Title"] = "Documents"; ViewData["WorkProject"] = Model.Project; }
<h1>Documents</h1>

<p class="action-links"><a asp-controller="Projects" asp-action="Details" asp-route-id="@Model.Project.Id">Back to project</a>
 <a asp-action="Create" asp-route-projectId="@Model.Project.Id" class="btn btn-primary">Create document</a>
</p>
@if (Model.Total == 0) { <p>No documents.</p> }
else
{
    <p>@Model.Total @(Model.Total == 1 ? "document" : "documents"). Page @Model.Page of @Model.PageCount.</p>
    <div class="table-responsive"><table class="table table-striped">
        <thead><tr><th>Title</th><th>Version</th><th>Updated (UTC)</th><th>Updated by</th></tr></thead>
        <tbody>@foreach (var document in Model.Items)
        { <tr><td class="project-text"><a asp-action="Details" asp-route-projectId="@Model.Project.Id" asp-route-id="@document.Id">@document.Title</a></td><td>@document.Version</td><td>@document.UpdatedAtUtc.ToString("yyyy-MM-dd HH:mm")</td><td class="project-text"><partial name="_Person" model="document.UpdatedBy" /></td></tr> }
        </tbody>
    </table></div>
    <nav aria-label="Document pages"><ul class="pager">
    @if (Model.Page > 1)
    { <li><a asp-action="Index" asp-route-projectId="@Model.Project.Id" asp-route-page="@(Model.Page - 1)">Previous</a></li> }
    @if (Model.Page < Model.PageCount)
    { <li><a asp-action="Index" asp-route-projectId="@Model.Project.Id" asp-route-page="@(Model.Page + 1)">Next</a></li> }
    </ul></nav>
}
