@{ var project = ViewData["WorkProject"] as Workboard.Application.WorkItems.WorkProject; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Workboard</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap-theme.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-default">
        <div class="container-fluid">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#navigation" aria-expanded="false" aria-controls="navigation">
                    <span class="sr-only">Toggle navigation</span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">Workboard</a>
            </div>
            <div class="collapse navbar-collapse" id="navigation">
                <ul class="nav navbar-nav">
                    <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li><a asp-controller="Projects" asp-action="Index">Projects</a></li>
                    }
                </ul>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="navbar-right">
                        <p class="navbar-text">@User.Identity.Name</p>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="navbar-form">
                            <button type="submit" class="btn btn-default">Sign out</button>
                        </form>
                    </div>
                }
                else
                {
                    <ul class="nav navbar-nav navbar-right">
                        <li><a asp-controller="Account" asp-action="Login">Sign in</a></li>
                    </ul>
                }
            </div>
        </div>
    </nav>
    <div class="@(project == null ? "" : "project-workspace")">
    @if (project != null) { <aside class="project-sidebar"><partial name="~/Views/WorkItems/_WorkNavigation.cshtml" model="project" /></aside> }
    <main class="@(project == null ? "container" : "workspace-main")" data-workspace-project="@project?.Id">
    <div data-workspace-notice class="alert alert-danger hidden" role="alert"></div>
    <div data-workspace-content>
        @if (TempData["Success"] is string success && Context.Response.StatusCode < 400)
        {
            <div class="alert alert-success" role="status">@success</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger" role="alert">@error</div>
        }
        @RenderBody()
    </div>
    </main>
    </div>
    @if (project != null) { <partial name="_WorkPreview" /><partial name="_ContextModal" /> }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.js"></script>
    @if (project != null)
    {
        <script src="~/lib/sortable/Sortable.min.js"></script>
        <script src="~/js/context-modal.js" asp-append-version="true"></script>
        <script src="~/js/board.js" asp-append-version="true"></script>
        <script src="~/js/workspace.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
