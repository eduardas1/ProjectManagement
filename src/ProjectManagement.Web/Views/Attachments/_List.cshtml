@model ProjectManagement.Application.Attachments.TargetAttachments

<p>
 <a data-modal-form data-modal-title="Upload file" asp-action="Upload" asp-route-projectId="@Model.Target.Project.Id" asp-route-workItemId="@Model.Target.WorkItemId" asp-route-documentId="@Model.Target.DocumentId" class="btn btn-primary">Upload file</a>
</p>
@if (Model.Total == 0) { <p>No attachments.</p> }
else
{
    <div class="table-responsive"><table table-options="@(Model.Table ?? new())" table-page="@Model.Page" table-total="@Model.Total" table-context="true" class="table table-striped">
        <thead><tr><th table-sort="name">File</th><th table-sort="size">Size (bytes)</th><th table-sort="uploaded">Uploaded (UTC)</th><th table-sort="author">Uploaded by</th><th>Actions</th></tr></thead>
        <tbody>@foreach (var file in Model.Items)
        {
            <tr><td class="project-text attachment-name"><a asp-action="Download" asp-route-projectId="@Model.Target.Project.Id" asp-route-id="@file.Id">@file.DisplayName</a></td><td>@file.Length</td><td>@file.UploadedAtUtc.ToString("yyyy-MM-dd HH:mm")</td><td class="project-text"><partial name="_Person" model="file.UploadedBy" /></td><td>
            @if (file.CanRemove) { <a data-modal-form data-modal-title="Remove file" asp-action="Remove" asp-route-projectId="@Model.Target.Project.Id" asp-route-id="@file.Id">Remove</a> }
            </td></tr>
        }</tbody>
    </table></div>
}
