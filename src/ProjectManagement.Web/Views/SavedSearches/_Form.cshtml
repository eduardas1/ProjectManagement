@model SavedSearchFormViewModel
<form asp-controller="SavedSearches" asp-action="@Model.Action" asp-route-projectId="@Model.ProjectId" asp-route-id="@(Model.Action == "Create" ? (int?)null : Model.Id)" method="post" data-modal-submit>
    <input asp-for="ProjectId" type="hidden" /><input asp-for="Id" type="hidden" /><input asp-for="ExpectedVersion" type="hidden" /><input asp-for="ReturnUrl" type="hidden" />
    <div asp-validation-summary="All" class="text-danger" role="alert" tabindex="-1"></div>
    @if (Model.Action == "Delete")
    {
        <p>Delete your saved search <strong class="project-text">@Model.Name</strong>?</p>
    }
    else
    {
        <div class="form-group"><label asp-for="Name">Name</label><input asp-for="Name" maxlength="100" class="form-control" autocomplete="off" /></div>
    }
    @if (Model.Action == "Create")
    {
        <input asp-for="Expression" type="hidden" /><input asp-for="Ordering" type="hidden" /><input asp-for="Archived" type="hidden" />
        <p>This private search opens active work in this project.</p>
        <p>Expression: <code>@(string.IsNullOrWhiteSpace(Model.Expression) ? "All work" : Model.Expression)</code></p>
        <p>Order: <code>@(string.IsNullOrWhiteSpace(Model.Ordering) ? "number" : Model.Ordering)</code></p>
    }
    @if (!Model.Project.IsArchived && !(Model.Action == "Create" && Model.Archived))
    {
        <button type="submit" class="btn @(Model.Action == "Delete" ? "btn-danger" : "btn-primary")">@Model.Title</button>
    }
    <a href="@(Model.ReturnUrl ?? Url.Action("Index", "SavedSearches", new { projectId = Model.ProjectId }))" class="btn btn-default" data-modal-cancel>Cancel</a>
</form>
