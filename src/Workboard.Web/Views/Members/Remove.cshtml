@model RemoveMemberViewModel
@{ ViewData["Title"] = "Remove member"; }

<h1 class="project-text">Remove member from @Model.ProjectKey</h1>
<p class="project-text">Revoke access for @Model.Email?</p>
<form asp-action="Remove" asp-route-id="@Model.ProjectId" method="post">
    <input asp-for="ProjectId" type="hidden" />
    <input asp-for="ExpectedVersion" type="hidden" />
    <input asp-for="UserId" type="hidden" />
    <div asp-validation-summary="All" class="text-danger"></div>
    <button type="submit" class="btn btn-danger">Remove member</button>
    <a asp-action="Index" asp-route-id="@Model.ProjectId" class="btn btn-default">Cancel</a>
    <a asp-action="Remove" asp-route-id="@Model.ProjectId" asp-route-userId="@Model.UserId">Reload current version</a>
</form>
