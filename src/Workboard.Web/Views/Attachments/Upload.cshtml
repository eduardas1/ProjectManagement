@model UploadAttachmentViewModel
@{ ViewData["Title"] = "Upload file"; }
<h1>Upload file</h1>
<p class="project-text">@Model.Target.Title</p>
<div class="row"><div class="col-md-8">
<form asp-action="Upload" asp-route-projectId="@Model.ProjectId" asp-route-workItemId="@Model.WorkItemId" asp-route-documentId="@Model.DocumentId" method="post" enctype="multipart/form-data">
    <input asp-for="ProjectId" type="hidden" /><input asp-for="WorkItemId" type="hidden" /><input asp-for="DocumentId" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group">
        <label asp-for="File"></label><input asp-for="File" type="file" accept=".pdf,.png,.jpg,.jpeg,.txt,.csv" aria-describedby="file-help" />
        <p id="file-help" class="help-block">PDF, PNG, JPEG, UTF-8 text or CSV. Maximum 5 MiB. Select your file again after an error.</p>
        <span asp-validation-for="File" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Upload file</button>
    <a asp-action="Index" asp-route-projectId="@Model.ProjectId" asp-route-workItemId="@Model.WorkItemId" asp-route-documentId="@Model.DocumentId" class="btn btn-default">Cancel</a>
</form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
