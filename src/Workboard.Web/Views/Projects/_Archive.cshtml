@model ArchiveProjectViewModel
@{ var action = Model.IsArchived ? "Archive" : "Restore"; }
<p class="project-text">@Model.Name</p>
<p>@(Model.IsArchived ? "Archived projects remain available to their members as read-only." : "This project will return to the active project list.")</p>
<form data-modal-submit asp-action="Archive" asp-route-id="@Model.ProjectId" method="post">
    <input asp-for="ProjectId" type="hidden" />
    <input asp-for="ExpectedVersion" type="hidden" />
    <input asp-for="IsArchived" type="hidden" />
    <div asp-validation-summary="All" class="text-danger" tabindex="-1" role="alert"></div>
    <div class="form-actions">
        <button type="submit" class="btn btn-warning">@action project</button>
        <a asp-action="Details" asp-route-id="@Model.ProjectId" class="btn btn-default" data-modal-cancel>Cancel</a>
    </div>
</form>
