@model CreateDocumentViewModel
@{ ViewData["Title"] = "Create document"; ViewData["WorkProject"] = Model.Project; }
<h1>Create document</h1>
<p class="project-text">@Model.Project.Key - @Model.Project.Name</p>
<form data-document-dirty data-unsaved="@((Context.Response.StatusCode >= 400).ToString().ToLowerInvariant())" asp-action="Create" asp-route-projectId="@Model.ProjectId" method="post">
    <input asp-for="ProjectId" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group">
        <label asp-for="Title"></label><input asp-for="Title" class="form-control" maxlength="200" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Format"></label>
        <select asp-for="Format" class="form-control" asp-items="Html.GetEnumSelectList<ProjectManagement.Domain.Enums.DocumentFormat>()"></select>
        <span asp-validation-for="Format" class="text-danger"></span>
        <p class="help-block">Plain text keeps your text as entered. Markdown supports headings, lists and links.</p>
    </div>
    <div class="form-group">
        <label asp-for="Body"></label><textarea asp-for="Body" class="form-control" rows="15" maxlength="100000"></textarea>
        <span asp-validation-for="Body" class="text-danger"></span>
    </div>
    <div class="document-preview-tools hidden" data-document-preview>
        <button type="button" class="btn btn-default" data-preview-url="@Url.Action("Preview", new { projectId = Model.ProjectId })">Preview text</button>
        <span role="status" data-preview-status></span>
        <section class="document-reading hidden" aria-label="Text preview" data-preview-content></section>
    </div>
    <button type="submit" class="btn btn-primary">Create document</button>
    <a asp-action="Index" asp-route-projectId="@Model.ProjectId" class="btn btn-default">Cancel</a>

</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
